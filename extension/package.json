{
  "name": "codemeet",
  "displayName": "CodeMeet",
  "description": "Live collaboration in VS Code between developers and their coding agents (Claude, Codex) through a server you control",
  "version": "0.1.0",
  "publisher": "raunaksahahere",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raunaksahahere/codemeet"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Education"
  ],
  "icon": "icon.png",
  "keywords": [
    "collaboration",
    "real-time",
    "pair-programming",
    "ai-agents",
    "claude",
    "codex",
    "live-coding"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies --allow-missing-repository",
    "clean": "rimraf dist"
  },
  "contributes": {
    "commands": [
      {
        "command": "codemeet.createRoom",
        "title": "CodeMeet: Create Room",
        "icon": "$(broadcast)"
      },
      {
        "command": "codemeet.joinRoom",
        "title": "CodeMeet: Join Room",
        "icon": "$(plug)"
      },
      {
        "command": "codemeet.leaveRoom",
        "title": "CodeMeet: Leave Room",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "codemeet.runAgent",
        "title": "CodeMeet: Run My Agent (Claude or Codex)"
      },
      {
        "command": "codemeet.reviewProposal",
        "title": "CodeMeet: Review Proposal"
      },
      {
        "command": "codemeet.approveProposal",
        "title": "CodeMeet: Approve Proposal"
      },
      {
        "command": "codemeet.rejectProposal",
        "title": "CodeMeet: Reject Proposal"
      },
      {
        "command": "codemeet.grantPermission",
        "title": "CodeMeet: Grant Agent Permission"
      },
      {
        "command": "codemeet.revokePermission",
        "title": "CodeMeet: Revoke Agent Permission"
      },
      {
        "command": "codemeet.responderMode",
        "title": "CodeMeet: Set Agent Reply Mode"
      },
      {
        "command": "codemeet.showMessages",
        "title": "CodeMeet: Show Agent Messages"
      },
      {
        "command": "codemeet.copyRoomId",
        "title": "CodeMeet: Copy Room ID"
      },
      {
        "command": "codemeet.openSharedNotes",
        "title": "CodeMeet: Open Shared Notes"
      },
      {
        "command": "codemeet.openPrivateNotes",
        "title": "CodeMeet: Open Private Notes",
        "icon": "$(lock)"
      },
      {
        "command": "codemeet.showLog",
        "title": "CodeMeet: Show Log"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codemeet-sidebar",
          "title": "CodeMeet",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "codemeet-sidebar": [
        {
          "type": "webview",
          "id": "codemeet.sidebarView",
          "name": "CodeMeet"
        }
      ]
    },
    "configuration": {
      "title": "CodeMeet",
      "properties": {
        "codemeet.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:3001",
          "description": "URL of the CodeMeet server run by your team (codemeet server start). Use https:// for anything beyond localhost or a trusted LAN."
        },
        "codemeet.displayName": {
          "type": "string",
          "default": "",
          "description": "Name shown to collaborators."
        }
      }
    }
  },
  "devDependencies": {
    "@codemeet/core": "workspace:*",
    "@codemeet/shared": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.20.0",
    "fast-diff": "^1.3.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.4.0"
  },
  "author": "Raunak Saha",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "CodeMeet reads and writes files in the workspace folder, so it needs a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "CodeMeet syncs files on disk."
    }
  }
}
