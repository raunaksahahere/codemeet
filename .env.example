# Copy to .env (or run `codemeet init`, which writes ~/.codemeet/server.env with owner-only permissions).
# Never commit real values. This file contains placeholders only.

# --- REQUIRED: a PostgreSQL connection string (NOT an API key) -----------------------------------
# Local (docker compose up -d postgres):
DATABASE_URL=postgresql://codemeet:CHANGE_ME@127.0.0.1:5432/codemeet?sslmode=disable
# Neon (Console -> Connect; use the DIRECT/unpooled string for migrations):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require
# Supabase (Dashboard -> Connect; Session pooler or Direct; NOT the anon/service-role key):
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# --- TLS to the database --------------------------------------------------------------------------
# auto (default): follows sslmode in the URL; hosted databases are always certificate-verified.
# CODEMEET_DB_SSL=auto
# Supabase certificates are not in Node's default trust store: download the root certificate from
# Dashboard -> Database settings and point to it. Verification stays ON.
# CODEMEET_DB_SSL_CA_FILE=/path/to/supabase-root.crt

# --- Server ---------------------------------------------------------------------------------------
# HOST=127.0.0.1            # 0.0.0.0 for LAN; put a TLS reverse proxy in front for anything public
# PORT=3001
# CODEMEET_ROOM_TTL_MINUTES=720      # idle time before a room expires
# CODEMEET_RETENTION_DAYS=7          # closed rooms are purged after this many days
# CODEMEET_TRUST_PROXY=1             # behind a reverse proxy: trust X-Forwarded-For
# CODEMEET_CORS_ORIGINS=             # comma-separated browser origins (normally empty)
# CODEMEET_MAX_CREATES_PER_MINUTE=10
# CODEMEET_MAX_JOINS_PER_MINUTE=20

# --- Client side (not read by the server) ---------------------------------------------------------
# CODEMEET_HOME=~/.codemeet           # per-user state; use another dir to run a second identity
# CODEMEET_ROOM_PASSWORD=             # non-interactive room create/join (prefer the masked prompt)
# CODEMEET_CLAUDE_BIN=claude  CODEMEET_CODEX_BIN=codex
